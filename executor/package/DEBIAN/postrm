#!/bin/sh
set -eu
if [ "${1:-}" = purge ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge mayi-broker.service mayi-pam-auth.service mayi-privileged-executor.service >/dev/null || true
    fi
    rm -rf -- /var/lib/mayi-privileged-executor /var/lib/mayi-broker
    # Human role accounts and role groups are administrator-managed. Never
    # remove identities by name; retain package service accounts as harmless
    # system-account remnants, as permitted by Debian package lifecycle policy.
fi
rmdir /run/mayi/request /run/mayi/approval /run/mayi/pam-auth /run/mayi/executor /run/mayi 2>/dev/null || true
exit 0
