[Unit]
Description=Mayi authorization broker
Requires=mayi-privileged-executor.service mayi-pam-auth.service
After=mayi-privileged-executor.service mayi-pam-auth.service
StartLimitIntervalSec=60s
StartLimitBurst=300

[Service]
Type=simple
User=mayi-broker
Group=mayi-broker-socket
SupplementaryGroups=mayi-requester mayi-approver
ExecStart=/usr/bin/mayi-executor --request-socket /run/mayi/request/broker.sock --request-gid 23011 --approval-socket /run/mayi/approval/broker.sock --approval-gid 23013
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/mayi/request /run/mayi/approval

[Install]
WantedBy=multi-user.target
